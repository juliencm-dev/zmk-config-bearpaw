#include "bearpaw.dtsi"

&default_transform {
    col-offset = <6>;
};

/ {
    chosen {
        zmk,kscan = &kscan_right;
    };

    kscan_right: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN_RIGHT";
        diode-direction = "col2row";
        row-gpios = <&gpio0 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio1 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio1 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio1 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;

        col-gpios = <&gpio0 2 (GPIO_ACTIVE_HIGH)>,
                    <&gpio1 15 (GPIO_ACTIVE_HIGH)>,
                    <&gpio1 13 (GPIO_ACTIVE_HIGH)>,
                    <&gpio1 11 (GPIO_ACTIVE_HIGH)>,
                    <&gpio0 10 (GPIO_ACTIVE_HIGH)>,
                    <&gpio0 9 (GPIO_ACTIVE_HIGH)>;
    };
};

&spi1 {
    compatible = "nordic,nrf-spim";
    status = "okay";

     mosi-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
    sck-gpios = <&gpio0 31 GPIO_ACTIVE_HIGH>;
    cs-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;

    nice_view: nice_view@0 {
        compatible = "nordic,nrf-spi";
        status = "okay";

        spi-max-frequency = <4000000>;
        reg = <0>;

        // Link CS pin configuration
        cs-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
    };
};
