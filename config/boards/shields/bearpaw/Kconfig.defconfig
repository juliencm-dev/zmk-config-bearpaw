if SHIELD_BEARPAW_LEFT

config ZMK_KEYBOARD_NAME
    default "Bearpaw"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_USB
    default y

endif # SHIELD_BEARPAW_LEFT

if SHIELD_BEARPAW_LEFT || SHIELD_BEARPAW_RIGHT

config ZMK_SPLIT
    default y

endif # SHIELD_BEARPAW_LEFT || SHIELD_BEARPAW_RIGHT

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL